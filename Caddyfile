#endpoint authelia
:9091 {
	reverse_proxy authelia:9091
}

# snippet auth verso webapp
(authelia_auth) {
	forward_auth authelia:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
	}
}

(reverse_proxy_apps_snippet) {
    reverse_proxy app1:5000 app2:5000 {
		lb_policy round_robin
	}
}


# endpoint protetto al load-balancer dei server della webapp
:80 {

    # path /
    handle {
        import reverse_proxy_apps_snippet
    }

    @publish path /publish

	handle @publish {
		import authelia_auth
		import reverse_proxy_apps_snippet
	}
}

# endpoint protetto alla dashboard emqx
:18083 {
	import authelia_auth
	reverse_proxy emqx:18083
}
